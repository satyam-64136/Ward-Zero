# Copy to .env (never commit real values). All settings are optional.
PORT=5000
HOST=127.0.0.1               # localhost only; set 0.0.0.0 deliberately to expose on a network
WARDZERO_DB=wardzero.db      # SQLite file path
ESCALATION_SECONDS=30        # seconds per escalation step (caregiver -> family -> doctor)
NOTE_WINDOW_SECONDS=1800     # how long a caregiver note influences risk
API=http://127.0.0.1:5000    # simulator target
